[Unit]
Description=Google Drive Pessoal System Tray Indicator (Wayland / COSMIC)
After=graphical-session.target gdrive-pessoal.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/rclone-cloud-indicator.py --profile gdrive-pessoal
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
