# ==========================================
# CONFIGURAÇÕES DO GIT
# ==========================================
GIT_USER_NAME="Seu Nome Aqui"
GIT_USER_EMAIL="seu_email@exemplo.com"

# ==========================================
# CONFIGURAÇÕES DO RCLONE
# ==========================================
# Insira os dados abaixo para configurar as nuvens automaticamente.
# Caso deixe em branco, o script tentará copiar um rclone.conf ou pedirá interação.

# MEGA (Login e Senha)
# RCLONE_CONFIG_MEGA_PESSOAL_TYPE=mega
# RCLONE_CONFIG_MEGA_PESSOAL_USER="seu_email_do_mega"
# RCLONE_CONFIG_MEGA_PESSOAL_PASS="sua_senha_do_mega_aqui"

# ONEDRIVE e GDRIVE geralmente precisam do token gerado previamente.
# (Cole o JSON completo do token dentro das aspas simples)
# RCLONE_CONFIG_GDRIVE_PESSOAL_TYPE=drive
# RCLONE_CONFIG_GDRIVE_PESSOAL_SCOPE=drive
# RCLONE_CONFIG_GDRIVE_PESSOAL_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'

# RCLONE_CONFIG_ONEDRIVE_PESSOAL_TYPE=onedrive
# RCLONE_CONFIG_ONEDRIVE_PESSOAL_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'
# RCLONE_CONFIG_ONEDRIVE_PESSOAL_DRIVE_ID="seu_drive_id_aqui"
# RCLONE_CONFIG_ONEDRIVE_PESSOAL_DRIVE_TYPE="personal"

# ==========================================
# IDENTIFICADORES DE HARDWARE & PERIFÉRICOS
# ==========================================
# Bluetooth (Endereços MAC dos seus dispositivos)
MAC_DUALSENSE_01="XX:XX:XX:XX:XX:XX"
MAC_DUALSENSE_02="YY:YY:YY:YY:YY:YY"
MAC_QCY_H3S="AA:BB:CC:DD:EE:FF"
MAC_WACOM_INTUOS="00:11:22:33:44:55"

# USB / Hardware (Vendor ID : Product ID do lsusb)
USB_ID_LOGITECH_G502X="046d:c547"
USB_ID_LOGITECH_G733="046d:0ab5"
USB_ID_LOGITECH_C920="046d:08e5"
USB_ID_WACOM_PTH460_USB="056a:0392"
USB_ID_WACOM_PTH460_BT="056a:0393"
USB_ID_KEYBOARD_REDRAGON="3554:fa09"
