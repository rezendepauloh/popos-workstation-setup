# ==========================================
# CONFIGURAÇÕES DO GIT
# ==========================================
GIT_USER_NAME="Seu Nome Aqui"
GIT_USER_EMAIL="seu_email@exemplo.com"

# ==========================================
# CONFIGURAÇÕES DO RCLONE
# ==========================================
# Insira os dados abaixo para configurar as nuvens automaticamente.
# Caso deixe em branco, o script tentará copiar um rclone.conf ou pedirá interação.

# MEGA (Login e Senha)
# RCLONE_CONFIG_MEGA_PESSOAL_TYPE=mega
# RCLONE_CONFIG_MEGA_PESSOAL_USER="seu_email_do_mega"
# RCLONE_CONFIG_MEGA_PESSOAL_PASS="sua_senha_do_mega_aqui"

# ONEDRIVE e GDRIVE geralmente precisam do token gerado previamente.
# (Cole o JSON completo do token dentro das aspas simples)
# RCLONE_CONFIG_GDRIVE_PESSOAL_TYPE=drive
# RCLONE_CONFIG_GDRIVE_PESSOAL_SCOPE=drive
# RCLONE_CONFIG_GDRIVE_PESSOAL_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'

# RCLONE_CONFIG_ONEDRIVE_PESSOAL_TYPE=onedrive
# RCLONE_CONFIG_ONEDRIVE_PESSOAL_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'
# RCLONE_CONFIG_ONEDRIVE_PESSOAL_DRIVE_ID="seu_drive_id_aqui"
# RCLONE_CONFIG_ONEDRIVE_PESSOAL_DRIVE_TYPE="personal"

# ==========================================
# IDENTIFICADORES DE HARDWARE & PERIFÉRICOS
# ==========================================
# Bluetooth (Endereços MAC e Nomes dos seus dispositivos)
MAC_DUALSENSE_01="XX:XX:XX:XX:XX:XX"
MAC_DUALSENSE_02="YY:YY:YY:YY:YY:YY"
MAC_QCY_H3S="AA:BB:CC:DD:EE:FF"
BT_AUDIO_DEVICE_NAME="QCY H3S"
MAC_WACOM_INTUOS="00:11:22:33:44:55"

# USB / Hardware (Vendor ID : Product ID do lsusb)
USB_ID_LOGITECH_G502X="1111:0000"
USB_ID_LOGITECH_G733="1111:0000"
USB_ID_LOGITECH_C920="1111:0000"
USB_ID_WACOM_PTH460_USB="1111:0000"
USB_ID_WACOM_PTH460_BT="1111:0000"
USB_ID_KEYBOARD_REDRAGON="1111:0000"

# ==========================================
# TRABALHO REMOTO & VPN INSTITUCIONAL (MPMS)
# ==========================================
# Servidor e credenciais da VPN SSL
VPN_HOST="host.com"
VPN_PORT="443"
VPN_USERNAME="seu_usuario_de_rede"
# Senha da VPN (Preencha para pular digitação e pedir apenas o Token 2FA)
VPN_PASSWORD="sua_senha_vpn_aqui"
VPN_TRUSTED_CERT="certificado_aqui"

# Conexão RDP Remmina (Máquina do Trabalho)
RDP_PROFILE_NAME="Trabalho Remoto"
RDP_PROFILE_ID="trabalho_remoto"
RDP_SERVER="computador.dominio"
RDP_USERNAME="seu_usuario_de_rede"
RDP_DOMAIN="dominio"
RDP_PASSWORD="sua_senha_rdp_aqui"

# ==========================================
# CONFIGURAÇÕES DE REDE & DNS LOCAL
# ==========================================
# Servidores de DNS e domínio local para resolução interna (ex: ~pk.local)
LOCAL_DNS_PRIMARY="192.168.0.8"
LOCAL_DNS_SECONDARY="1.1.1.1"
LOCAL_DNS_SEARCH_DOMAIN="~pk.local"

# ==========================================
# COMPARTILHAMENTO SAMBA (REDE LOCAL)
# ==========================================
# Diretório compartilhado e senha de acesso na rede local
SAMBA_SHARE_PATH="/mnt/storage_700/samba"
SAMBA_PASSWORD="sua_senha_samba_aqui"

# ==========================================
# NEXTCLOUD HOMELAB / SYNC
# ==========================================
# URL da instância Nextcloud (mini PC / Homelab UmbrelOS) e pasta local de sincronização
NEXTCLOUD_SERVER_URL="http://nextcloud:porta"
NEXTCLOUD_SYNC_DIR="/home/usuario/Nextcloud"

# ==========================================
# WINAPPS (MICROSOFT 365 & WINDOWS RDP SEAMLESS)
# ==========================================
# Credenciais e parâmetros da VM/Container Windows (dockurr/windows)
WINAPPS_RDP_USER="winapps"
WINAPPS_RDP_PASSWORD="sua_senha_winapps"
WINAPPS_RDP_IP="127.0.0.1"
WINAPPS_RDP_PORT="3389"
WINAPPS_WINDOWS_VERSION="win11"
WINAPPS_RAM_SIZE="4G"
WINAPPS_CPU_CORES="4"

# ==========================================
# AUTOMAÇÕES ESPANSO (OPCIONAL)
# ==========================================
# Repositório Git de pacotes customizados do Espanso
# ESPANSO_REPO_URL="https://github.com/seu-usuario/espanso-automacoes.git"

# ==========================================
# ACESSO REMOTO: WINDOWS 11 (SSH & MOONLIGHT)
# ==========================================
# Nome de exibição do PC Windows 11 na aba Dispositivos
REMOTE_WIN_LABEL="Windows 11 Remoto"
# Hostname mDNS (ex: nome-pc.local) ou IP na rede local (usado primeiro no modo LAN)
REMOTE_WIN_LAN_HOST="nome-pc.local"
# IP ou hostname Tailscale do Windows 11 (usado no modo Tailscale e como fallback da LAN)
REMOTE_WIN_TS_HOST="100.x.y.z"
# Nome do usuário de login no Windows 11 para conexão SSH
REMOTE_WIN_USER="usuario_windows"
# Endereço MAC da placa de rede do Windows 11 para ligar remotamente via Wake-on-LAN
REMOTE_WIN_MAC=""

# ==========================================
# ACESSO REMOTO: ANDROID (ADB WI-FI & SCRCPY)
# ==========================================
# Nome de exibição do celular Android na aba Dispositivos
REMOTE_ANDROID_LABEL="Android (ADB Wi-Fi)"
# IP local do celular Android na rede Wi-Fi para conexão ADB sem fio
REMOTE_ANDROID_LAN_HOST="192.168.0.x"
# IP Tailscale do celular Android para acesso fora de casa / VPN
REMOTE_ANDROID_TS_HOST=""
# Porta TCP do servidor ADB no Android (padrão: 5555)
REMOTE_ANDROID_PORT="5555"

# ==========================================
# ACESSO REMOTO: SMART TV SAMSUNG (TIZEN)
# ==========================================
# Nome de exibição da Smart TV Samsung na aba Dispositivos
REMOTE_TV_LABEL="Smart TV Samsung"
# IP local da Smart TV Samsung para controle Tizen LAN (porta 8001)
REMOTE_TV_IP=""
# Endereço MAC da Smart TV Samsung para ligar via Wake-on-LAN
REMOTE_TV_MAC=""

# ==========================================
# ACESSO REMOTO: PROJETOR SAMSUNG (TIZEN)
# ==========================================
# Nome de exibição do Projetor Samsung na aba Dispositivos
REMOTE_PROJECTOR_LABEL="Projetor Samsung"
# IP local do Projetor Samsung para controle Tizen LAN (porta 8001)
REMOTE_PROJECTOR_IP=""
# Endereço MAC do Projetor Samsung para ligar via Wake-on-LAN
REMOTE_PROJECTOR_MAC=""

# ==========================================
# ACESSO REMOTO: ALEXA & HOME ASSISTANT
# ==========================================
# URL base do Home Assistant no Homelab (ex: http://home.pk.local)
HA_URL="http://home.pk.local"
# Token de acesso de longa duração (Long-Lived Access Token) gerado no Home Assistant
HA_TOKEN=""
# Serviço de notificação TTS da Alexa no Home Assistant (ex: notify.alexa_media)
HA_ALEXA_NOTIFY_SERVICE="notify.alexa_media"
